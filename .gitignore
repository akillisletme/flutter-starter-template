# Firebase istemci yapilandirmasi — projeye ozel, klonlayan kendi projesiyle uretir.
google-services.json
GoogleService-Info.plist

# NOT: `lib/firebase_options.dart` bilincli olarak IGNORE EDILMEZ.
# Template, Firebase paketleriyle derlenebilmek icin o dosyanin bir
# placeholder surumunu tasir; ignore edilirse klonlayan derleyemez.
# `flutterfire configure` uzerine yazar. Icerigi sir degildir — Firebase
# istemci anahtarlari zaten uygulama paketiyle dagitilir, guvenlik Firebase
# Security Rules ile saglanir.

